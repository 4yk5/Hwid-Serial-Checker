<Window x:Class="OGCommunityInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OG COMMUNITY - SETUP WIZARD"
        Icon="app.ico"
        Height="540" Width="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Inter, -apple-system, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="WindowCircleBtnClose" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="16" Background="#181B26" BorderBrush="#25FFFFFF" BorderThickness="1">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#EF4444"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#F87171"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InstallBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="18" Background="#14261C" BorderBrush="#504ADE80" BorderThickness="1.4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1C3D2B"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#904ADE80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#141722"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#25FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border CornerRadius="32" Background="#08090E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.75"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="32" Background="#08090E" BorderBrush="#28FFFFFF" BorderThickness="1.2"
                MouseLeftButtonDown="Window_MouseDown"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType"
                RenderOptions.ClearTypeHint="Enabled">

            <Grid Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Button HorizontalAlignment="Right" Style="{StaticResource WindowCircleBtnClose}" Click="Close_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="68" Height="68" CornerRadius="20" Background="#FFFFFF" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" Color="White" Opacity="0.45"/>
                        </Border.Effect>
                        <TextBlock Text="OG" FontSize="30" FontWeight="Black" Foreground="#08090E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                    </Border>

                    <TextBlock Text="OG COMMUNITY" FontSize="18" FontWeight="Black" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" Margin="0,14,0,3"/>
                    <TextBlock Text="SERIAL CHECKER &amp; HARDWARE AUDITOR" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>
                    <Border CornerRadius="8" Background="#142B20" BorderBrush="#404ADE80" BorderThickness="1" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="10,3">
                        <TextBlock Text="SETUP • v1" FontSize="9.5" FontWeight="Black" Foreground="#4ADE80"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="10,0,10,15">
                    <TextBlock Text="INSTALLATION DIRECTORY" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>

                    <Border CornerRadius="12" Background="#10121A" BorderBrush="#25FFFFFF" BorderThickness="1.2" Height="40" Padding="14,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock x:Name="TxtInstallPath" Text="C:\Users\Admin\AppData\Local\Programs\OG Community Serial Checker"
                                       FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="4,16,0,0">
                        <CheckBox x:Name="ChkDesktopShortcut" IsChecked="True" Content="Create Desktop Shortcut"
                                  FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkStartMenuShortcut" IsChecked="True" Content="Create Start Menu Shortcut"
                                  FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkLaunchAfter" IsChecked="True" Content="Launch OG Serial Checker when setup finishes"
                                  FontSize="12" FontWeight="SemiBold" Foreground="#4ADE80"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="10,0,10,16">
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="TxtStatus" Text="Ready to install." FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="TxtPercent" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Right" Visibility="Collapsed"/>
                    </Grid>
                    <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Background="#141622" Foreground="#4ADE80" BorderThickness="0"/>
                </StackPanel>

                <Grid Grid.Row="4" Margin="10,0,10,0">
                    <Button x:Name="BtnAction" Style="{StaticResource InstallBtnStyle}" Click="BtnAction_Click">
                        <TextBlock x:Name="TxtBtnAction" Text="INSTALL NOW" FontSize="13" FontWeight="Black" Foreground="#4ADE80" Margin="0,-1,0,0"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
